{
  "format": "endolexis-architecture",
  "version": 1,
  "name": "three specialists, never sleep",
  "note": "",
  "processors": [
    {
      "id": "p_vision",
      "unit": {
        "format": "endolexis-processor",
        "name": "vision",
        "title": "Vision",
        "description": "All of the clockwork eye: retina (brightness, colour opponents, contrast, balance), motion and where it went, edge energy.",
        "version": "1.0.0",
        "source": {
          "kind": "camera",
          "detail": "the room's camera: a 16×16 colour picture (RGB, 0..1) every moment",
          "raw": "image"
        },
        "inputs": 768,
        "outputs": 11,
        "output_names": [
          "brightness",
          "red_green",
          "blue_yellow",
          "contrast",
          "left_right",
          "top_bottom",
          "motion",
          "motion_dx",
          "motion_dy",
          "edges_h",
          "edges_v"
        ],
        "implementation": {
          "builtin": "vision"
        }
      },
      "x": 40,
      "y": 60
    },
    {
      "id": "p_hearing",
      "unit": {
        "format": "endolexis-processor",
        "name": "hearing",
        "title": "Hearing",
        "description": "All of the clockwork ear: loudness and band shares, timbre (centroid, flatness, pitch strength), rhythm (onsets, pulsing).",
        "version": "1.0.0",
        "source": {
          "kind": "microphone",
          "detail": "the room's microphone: 2048 samples at 8 kHz every moment (a quarter of a second)",
          "raw": "sound"
        },
        "inputs": 2048,
        "outputs": 9,
        "output_names": [
          "loudness",
          "low",
          "mid",
          "high",
          "centroid",
          "flatness",
          "pitch",
          "onsets",
          "pulsing"
        ],
        "implementation": {
          "builtin": "hearing"
        }
      },
      "x": 40,
      "y": 260
    },
    {
      "id": "p_touch",
      "unit": {
        "format": "endolexis-processor",
        "name": "touch",
        "title": "Touch",
        "description": "Key presses and mouse movement.",
        "version": "1.0.0",
        "source": {
          "kind": "keyboard and mouse",
          "detail": "key presses and mouse movement in the moment",
          "raw": "touch"
        },
        "inputs": 2,
        "outputs": 2,
        "output_names": [
          "keys",
          "mouse"
        ],
        "implementation": {
          "builtin": "touch"
        }
      },
      "x": 40,
      "y": 460
    }
  ],
  "olvasos": [
    {
      "id": "o1",
      "name": "Eye",
